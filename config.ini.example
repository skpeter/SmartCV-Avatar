[settings]
;server_port = The port the server will listen on.
server_port = 6565
;capture_mode = The way which the game will be captured. Set to "obs" for OBS, "game" for direct game capture, or "video" to replay a video file through vod.py.
capture_mode = game
;enable_broadcast = Whether we should broadcast its IP to the local network allowing for other applications to connect to it easier. Enabled by default (true).
enable_broadcast=true
;enable_confirmation_dialog = Whether we should display a popup before the match asking players to confirm which side they're playing on. Enabled by default (true).
enable_dialog=true
;executable_title = The title of the game window. Set this if using "game" capture mode.
executable_title = Avatar Legends
;refresh_rate = Should be kept to 0.5 seconds. How often the script will check for changes in the game.
refresh_rate = 0.5
;debug_mode = Outputs some more data in order to catch errors. Also creates snapshot images of data being read. Disabled by default, not recommended for long usage.
debug_mode = false

[video]
;Only used by vod.py, which replays a recording through the real detection loop and websocket server.
;path = The video file to replay.
path =
;start = Seconds into the file to begin at.
start = 0
;speed = Wall-clock playback multiplier. The video still advances one refresh_rate per poll, so detection sees the same cadence as live; 0 runs as fast as the file decodes.
speed = 1

[obs]
source_title =
host = localhost
port = 4455
password =
width=1920
height=1080
